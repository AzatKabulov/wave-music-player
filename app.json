{
  "expo": {
    "name": "Musify",
    "slug": "musify-personal-test",
    "version": "0.2.1",
    "orientation": "default",
    "icon": "./assets/owaryn-icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.owarynmusic",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101623",
        "foregroundImage": "./assets/owaryn-adaptive.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.owarynmusic",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/owaryn-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-localization",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-build-properties"
    ],
    "scheme": "saz",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "22eb6273-effb-4bb2-b6ee-3cdfe32bae7e"
      }
    },
    "owner": "azatkabulov"
  }
}
