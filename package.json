{
  "name": "owaryn-music",
  "version": "0.2.2",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "test:phones": "node scripts/start-phone-test.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/start-preview.mjs",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "api": "npm --prefix apps/api start",
    "test": "node --experimental-strip-types --test src/data/*.test.ts src/i18n/*.test.ts && npm --prefix apps/api test",
    "format": "prettier --write src apps/api/src apps/api/test scripts/*.mjs package.json app.json tsconfig.json eas.json",
    "format:check": "prettier --check src apps/api/src apps/api/test scripts/*.mjs package.json app.json tsconfig.json eas.json",
    "lint": "expo lint",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.8.0"
}
