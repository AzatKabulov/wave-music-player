      "html": "<div class=\"ds-mini\"><div class=\"ds-mini-row\"><button class=\"ds-mini-open\"><span class=\"ds-mini-art\"><svg aria-hidden=\"true\" width=\"42\" height=\"42\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m19 6-5.2-3.9a.5.5 0 0 0-.8.4V18\"/><circle cx=\"9\" cy=\"18\" r=\"4\"/></svg></span><span class=\"ds-mini-copy\"><span class=\"ds-mini-title\">Track title</span><span class=\"ds-mini-artist\">Artist name</span></span></button><button class=\"ds-mini-control\" aria-label=\"Pause\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"14\" y=\"3\" width=\"5\" height=\"18\" rx=\"1\"/><rect x=\"5\" y=\"3\" width=\"5\" height=\"18\" rx=\"1\"/></svg></button><button class=\"ds-mini-control\" aria-label=\"Next track\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 4v16\"/><path d=\"M6.029 4.285A2 2 0 0 0 3 6v12a2 2 0 0 0 3.029 1.715l9.997-5.998a2 2 0 0 0 .003-3.432z\"/></svg></button></div><div class=\"ds-mini-rail\"><div class=\"ds-mini-progress\"></div></div></div>",
      "css": ".ds-mini{box-sizing:border-box;margin:0 8px;border-radius:8px;overflow:hidden;background:#25252B;color:#FAFAFC;font-family:system-ui,-apple-system,Segoe UI,sans-serif}.ds-mini-row{box-sizing:border-box;display:flex;align-items:center;padding:6px;min-height:62px}.ds-mini-open{box-sizing:border-box;flex:1;min-width:0;display:flex;align-items:center;gap:12px;padding:0;border:0;background:transparent;color:inherit;text-align:left;transition:transform 140ms cubic-bezier(.215,.61,.355,1),opacity 140ms cubic-bezier(.215,.61,.355,1);}.ds-mini-art{box-sizing:border-box;width:44px;height:44px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:4px;color:#B5B5BF}.ds-mini-art svg{width:18px;height:18px;stroke-width:1.3}.ds-mini-copy{box-sizing:border-box;min-width:0;display:grid}.ds-mini-title{box-sizing:border-box;font:600 14px/20px system-ui,-apple-system,Segoe UI,sans-serif;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-mini-artist{box-sizing:border-box;font:400 13px/18px system-ui,-apple-system,Segoe UI,sans-serif;color:#B5B5BF}.ds-mini-control{box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-width:48px;min-height:48px;border:2px solid transparent;border-radius:999px;background:transparent;color:inherit;transition:transform 140ms cubic-bezier(.215,.61,.355,1),opacity 140ms cubic-bezier(.215,.61,.355,1);}.ds-mini-open:hover,.ds-mini-control:hover{cursor:pointer}.ds-mini-open:focus-visible{outline:auto}.ds-mini-control:focus-visible{outline:none;border-color:#41E2B1}.ds-mini-open:active,.ds-mini-control:active{transform:scale(.975);opacity:.84;transition-duration:80ms}.ds-mini-rail{box-sizing:border-box;height:2px;margin:0 8px;background:#45454F}.ds-mini-progress{box-sizing:border-box;height:2px;width:35%;background:#FAFAFC}@media(prefers-reduced-motion:reduce){.ds-mini-open:active,.ds-mini-control:active{transform:none}}"
    },
    {
      "name": "Action Sheet",
      "kind": "custom",
      "refersTo": "sheet",
      "description": "Static panel translation of src/ui/sheets/Sheet.tsx and Playback.tsx. Dismiss gestures, backdrop, Back and native modal semantics require the app runtime.",
      "html": "<section class=\"ds-sheet\" aria-label=\"Track options\"><div class=\"ds-sheet-grip\"><span></span></div><header class=\"ds-sheet-header\"><h3>Track options</h3><button class=\"ds-sheet-close\" aria-label=\"Close sheet\"><svg aria-hidden=\"true\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 6 6 18m0-12 12 12\"/></svg></button></header><div class=\"ds-sheet-content\"><button class=\"ds-sheet-action\">Add to playlist</button><button class=\"ds-sheet-action\">Play next</button></div></section>",
      "css": ".ds-sheet{box-sizing:border-box;max-width:560px;width:100%;border-radius:20px 20px 0 0;background:#18181C;color:#FAFAFC;overflow:hidden;padding-bottom:16px;font-family:system-ui,-apple-system,Segoe UI,sans-serif}.ds-sheet-grip{box-sizing:border-box;height:28px;display:flex;align-items:center;justify-content:center}.ds-sheet-grip span{width:36px;height:4px;border-radius:2px;background:#B5B5BF}.ds-sheet-header{box-sizing:border-box;display:flex;align-items:center;gap:12px;padding:0 8px 8px 24px}.ds-sheet-header h3{flex:1;margin:0;font:600 18px/24px system-ui,-apple-system,Segoe UI,sans-serif}.ds-sheet-close{box-sizing:border-box;min-width:48px;min-height:48px;display:flex;align-items:center;justify-content:center;border:2px solid transparent;border-radius:999px;background:transparent;color:inherit;transition:transform 140ms cubic-bezier(.215,.61,.355,1),opacity 140ms cubic-bezier(.215,.61,.355,1);}.ds-sheet-content{box-sizing:border-box;display:grid;gap:8px;padding:0 24px 16px}.ds-sheet-action{box-sizing:border-box;min-height:48px;padding:12px 8px;border:2px solid transparent;border-radius:999px;background:transparent;color:inherit;text-align:left;font:600 16px/22px system-ui,-apple-system,Segoe UI,sans-serif;transition:transform 140ms cubic-bezier(.215,.61,.355,1),opacity 140ms cubic-bezier(.215,.61,.355,1);}.ds-sheet-close:hover,.ds-sheet-action:hover{cursor:pointer}.ds-sheet-close:focus-visible,.ds-sheet-action:focus-visible{outline:none;border-color:#41E2B1}.ds-sheet-close:active,.ds-sheet-action:active{transform:scale(.975);opacity:.84;transition-duration:80ms}@media(prefers-reduced-motion:reduce){.ds-sheet-close:active,.ds-sheet-action:active{transform:none}}"
